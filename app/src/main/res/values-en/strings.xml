    <!-- Tutorials & Help -->
    <string name="help_section_1_title">1. Wireless Debugging (Wi-Fi)</string>
    <string name="help_section_1_desc">Go to Settings > Developer options > Wireless debugging. Make sure it is enabled.\n\nIf this is your first time using the app, go to the menu (gear icon) > Pair Device, and follow the steps to enter the 6-digit pairing code.</string>
    <string name="help_section_2_title">2. Direct Local Connection (USB Fallback)</string>
    <string name="help_section_2_desc">If your router blocks mDNS packets and the app cannot detect the port automatically, you can use this 100% offline mode:\n\n1. Connect your phone to a PC via cable.\n2. Run in your terminal: adb tcpip 5555\n3. Disconnect the cable.\n4. Press the button below to connect manually and autonomously.</string>

    <!-- Pairing Methods -->
    <string name="pairing_methods_desc">Android closes the pairing code when switching apps. Choose how you prefer to pair:</string>
    <string name="btn_pair_by_notification">1. Via Notification</string>
    <string name="btn_pair_by_notification_desc">Type the code directly from the top bar without leaving Settings.</string>
    <string name="btn_pair_by_split">2. Via Split Screen</string>
    <string name="btn_pair_by_split_desc">Opens a compact window so you can type while keeping Settings open on the other half.</string>
    <string name="dialog_split_pairing_hint">Enter the port and code shown in the Settings half:</string>

