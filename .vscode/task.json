{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "1. Iniciar Emulador (test_device)",
            "type": "shell",
            "command": "emulator -avd test_device -netdelay none -netspeed full",
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": ".*Boot completed.*"
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            }
        },
        {
            "label": "2. Compilar y Ejecutar en Emulador",
            "type": "shell",
            "command": "./gradlew installDebug && adb shell am start -n com.localadb.manager/.MainActivity",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}